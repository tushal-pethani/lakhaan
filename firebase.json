{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "android/**",
      "ios/**",
      "macos/**",
      "linux/**",
      "windows/**",
      "build/**",
      "lib/**",
      "test/**",
      "packages/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
