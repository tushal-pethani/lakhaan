rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public read access to specific documents for the invoice web viewer
    // (UUIDs make these unguessable without the direct link)
    match /users/{userId}/invoices/{invoiceId} {
      allow get: if true;
    }
    match /users/{userId}/clients/{clientId} {
      allow get: if true;
    }
    match /users/{userId}/profile/{document=**} {
      allow get: if true;
    }

    // Each user can read/write their own data
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Global analytics - any authenticated user can increment counters (write)
    // but only read is restricted to keep user data private
    match /analytics/{docId} {
      allow write: if request.auth != null;
      allow read: if request.auth != null;
    }
  }
}
